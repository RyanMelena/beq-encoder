# Copy to .env next to compose.yaml and adjust.

# uid:gid the containers run as: the owner of the media files
PUID=1000
PGID=1000

# Host folder holding the Linux Dolby Encoding Engine 6.7 tools, with the TrueHD encoder
# dee_dthd_encoder in it as built by dthd-mac2linux (https://github.com/truehdd/dthd-mac2linux:
# DEE 6.7 ships that encoder for macOS only). Bind-mounted read-only at the same path
# inside the container; the image's dee_shim runs the encoder from it (it runs without a
# license.lic beside it).
DEE_PATH=/srv/beq-encoder/dee

# Fast local scratch space shared by the encoder and the designer: a TrueHD / DD+ Atmos
# job needs ~3.2x its decoded master (~8.3 GB per hour of film: ~55 GB for two hours)
# for the decode, the filtered copy, DEE's temp files and the check; channel-based
# jobs far less. Plus the 1 kHz analysis cache. Not a network or Windows mount: DEE
# runs several times slower there.
WORK_DIR=/srv/beq-encoder/work

# The film library, mounted read-write at /media/movies (files are replaced in place
# after a verified remux).
MEDIA_DIR=/srv/media/movies

# beqforge designer image tag (ghcr.io/3ll3d00d/beqforge-designer). Pin it.
BEQFORGE_VERSION=0.3.3
# BEQFORGE_WORKERS=1

TZ=UTC
